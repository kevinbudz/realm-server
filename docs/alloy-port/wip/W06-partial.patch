+//[W06] Golden corpus for the packet builders: every outbound builder called with fixed inputs, written as hex lines.
+//Run with `dotnet RotMG.dll --w06-golden <file>` before and after a change to the writer; the two files must be equal.
+//Builders return byte[] before W06 and ReadOnlySpan<byte> after it, so the calls below use Convert.ToHexString,
+//which accepts both. Timing-driven frames (Update and NewTick in a live world) cannot be captured byte-for-byte, so
+//their builders are covered here with fixed inputs instead.
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Text;
+using RotMG.Common;
+using RotMG.Game;
+
+namespace RotMG.Networking
+{
+    public static class W06Golden
+    {
+        //[W06] --w06-verify: SpanReader against the stream-backed PacketReader it replaces. Random byte frames run
+        //through random read sequences; each step must return the same value (or the same exception type) and leave the
+        //same position. Also checks the writer's string bound, which the old writer did not have.
+        public static bool RunReaderCheck()
+        {
+            var rnd = new Random(20261015);
+            int trials = 0, steps = 0, exceptions = 0;
+            var failures = new List<string>();
+            for (int t = 0; t < 20000; t++)
+            {
+                byte[] buf = new byte[rnd.Next(0, 24)];
+                rnd.NextBytes(buf);
+                if (buf.Length >= 2 && rnd.Next(2) == 0)
+                {
+                    //Bias the first two bytes toward small positive and negative lengths so string/bytes reads overrun.
+                    short len = (short)rnd.Next(-3, 30);
+                    buf[0] = (byte)(len >> 8);
+                    buf[1] = (byte)len;
+                }
+                var legacy = new PacketReader(new MemoryStream(buf));
+                var span = new SpanReader(buf);
+                trials++;
+                for (int k = 0; k < 8; k++)
+                {
+                    int op = rnd.Next(10);
+                    int n = rnd.Next(4) == 0 ? -1 : rnd.Next(0, 6);
+                    steps++;
+                    string a = Step(legacy, op, n, out string ea);
+                    string b = StepSpan(ref span, op, n, out string eb);
+                    if (a != b || ea != eb)
+                    {
+                        failures.Add($"trial {t} step {k} op {op} n {n}: legacy={a}/{ea} span={b}/{eb}");
+                        break;
+                    }
+                    if (ea != null)
+                    {
+                        exceptions++;
+                        break;
+                    }
+                    if (legacy.BaseStream.Position != span.Position)
+                    {
+                        failures.Add($"trial {t} step {k} op {op}: position {legacy.BaseStream.Position} vs {span.Position}");
+                        break;
+                    }
+                }
+            }
+
+            //Writer bound: a 65535-byte UTF-8 string is the largest that fits the u16 prefix; one more byte must throw.
+            string max = new string('a', 65535);
+            PacketWriter wtr = PacketWriter.Rent();
+            wtr.Write(max);
+            if (PacketWriter.RentedBytes().Length != 65537 || PacketWriter.RentedBytes()[0] != 0xFF || PacketWriter.RentedBytes()[1] != 0xFF)
+                failures.Add("writer: 65535-byte string frame wrong");
+            bool threw = false;
+            try { PacketWriter.Rent().Write(max + "b"); }
+            catch (ArgumentOutOfRangeException) { threw = true; }
+            if (!threw)
+                failures.Add("writer: 65536-byte string did not throw");
+            threw = false;
+            try { PacketWriter.Rent().Write((string)null); }
+            catch (ArgumentNullException) { threw = true; }
+            if (!threw)
+                failures.Add("writer: null string did not throw ArgumentNullException (old behaviour)");
+
+            foreach (string f in failures.Count > 20 ? failures.GetRange(0, 20) : failures)
+                Console.WriteLine("  W06 verify FAIL: " + f);
+            Console.WriteLine($"W06 verify: reader {trials} frames, {steps} steps, {exceptions} exception paths, {failures.Count} mismatches");
+            return failures.Count == 0;
+        }
+
+        //Each op returns a canonical string for the value read, or the exception type name in err.
+        private static string Step(PacketReader r, int op, int n, out string err)
+        {
+            err = null;
+            try
+            {
+                switch (op)
+                {
+                    case 0: return r.ReadByte().ToString();
+                    case 1: return r.ReadBoolean().ToString();
+                    case 2: return r.ReadInt16().ToString();
+                    case 3: return r.ReadUInt16().ToString();
+                    case 4: return r.ReadInt32().ToString();
+                    case 5: return BitConverter.SingleToInt32Bits(r.ReadSingle()).ToString();
+                    case 6: return "s:" + r.ReadString();
+                    case 7: return "u:" + r.ReadUTF32();
+                    case 8: return "b:" + string.Join(",", r.ReadBytes(n));
+                    default: return "more:" + (r.BaseStream.Position < r.BaseStream.Length);
+                }
+            }
+            catch (Exception e)
+            {
+                err = e.GetType().Name;
+                return "throw";
+            }
+        }
+
+        private static string StepSpan(ref SpanReader r, int op, int n, out string err)
+        {
+            err = null;
+            try
+            {
+                switch (op)
+                {
+                    case 0: return r.ReadByte().ToString();
+                    case 1: return r.ReadBoolean().ToString();
+                    case 2: return r.ReadInt16().ToString();
+                    case 3: return r.ReadUInt16().ToString();
+                    case 4: return r.ReadInt32().ToString();
+                    case 5: return BitConverter.SingleToInt32Bits(r.ReadSingle()).ToString();
+                    case 6: return "s:" + r.ReadString();
+                    case 7: return "u:" + r.ReadUTF32();
+                    case 8: return "b:" + string.Join(",", r.ReadBytes(n));
+                    default: return "more:" + r.HasMore;
+                }
+            }
+            catch (Exception e)
+            {
+                err = e.GetType().Name;
+                return "throw";
+            }
+        }
+
+        public static bool Run(string outPath)
+        {
+            var lines = new List<string>();
+            void Add(string name, string hex) => lines.Add(name + " " + hex);
+
+            Add("MapInfo", Convert.ToHexString(GameServer.MapInfo(2048, 2048, "Nexus", "Realm", 0xDEADBEEFu, 3, true, false)));
+            Add("InvResult0", Convert.ToHexString(GameServer.InvResult(0)));
+            Add("InvResult1", Convert.ToHexString(GameServer.InvResult(1)));
+            Add("Failure", Convert.ToHexString(GameServer.Failure(2, "Too many connections from your address")));
+            Add("FailureEmpty", Convert.ToHexString(GameServer.Failure(0, "")));
+            Add("NameResultOk", Convert.ToHexString(GameServer.NameResult(true, "")));
+            Add("NameResultErr", Convert.ToHexString(GameServer.NameResult(false, "Not enough gold.")));
+            Add("CreateSuccess", Convert.ToHexString(GameServer.CreateSuccess(42, 7)));
+            Add("Reconnect", Convert.ToHexString(GameServer.Reconnect(42)));
+            Add("Ping", Convert.ToHexString(GameServer.Ping(9)));
+            Add("Goto", Convert.ToHexString(GameServer.Goto(5, new Position(1.5f, 2.5f))));
+            Add("Notification", Convert.ToHexString(GameServer.Notification(5, "text é中", 0xFFFFFFFFu)));
+            Add("GlobalNotification", Convert.ToHexString(GameServer.GlobalNotification(1, "gn")));
+            Add("QuestObjId", Convert.ToHexString(GameServer.QuestObjId(5)));
+            Add("BuyResult", Convert.ToHexString(GameServer.BuyResult(0, "ok")));
+            Add("GuildResult", Convert.ToHexString(GameServer.GuildResult(true, "g")));
+            Add("InvitedToGuild", Convert.ToHexString(GameServer.InvitedToGuild("a", "b")));
+            Add("TradeRequested", Convert.ToHexString(GameServer.TradeRequested("x")));
+            Add("TradeDone", Convert.ToHexString(GameServer.TradeDone(1, "done")));
+            Add("TradeChanged", Convert.ToHexString(GameServer.TradeChanged(new[] { true, false })));
+            Add("TradeAccepted", Convert.ToHexString(GameServer.TradeAccepted(new[] { true }, new[] { false })));
+            Add("TradeStart", Convert.ToHexString(GameServer.TradeStart(
+                new[] { new TradeItem { Item = 1, SlotType = 2, Tradeable = true, Included = false } },
+                "you",
+                new[] { new TradeItem { Item = -3, SlotType = 0, Tradeable = false, Included = true } })));
+            Add("AccountList", Convert.ToHexString(GameServer.AccountList(3, new List<int> { 1, 2, 3 })));
+            Add("AccountListEmpty", Convert.ToHexString(GameServer.AccountList(0, new List<int>())));
+            Add("PlaySound", Convert.ToHexString(GameServer.PlaySound("sound")));
+            Add("Death", Convert.ToHexString(GameServer.Death(1, 2, "Oryx")));
+            Add("AllyShoot", Convert.ToHexString(GameServer.AllyShoot(5, 0x0300, 1.25f)));
+            Add("Text", Convert.ToHexString(GameServer.Text("Name", 5, -1, 5, "", "hello")));
+            Add("TextRecipient", Convert.ToHexString(GameServer.Text("", 0, 3, 0, "Bob", "to bob")));
+            Add("Damage", Convert.ToHexString(GameServer.Damage(5, new[] { ConditionEffectIndex.Weak, ConditionEffectIndex.Quiet }, 100)));
+            Add("DamageNone", Convert.ToHexString(GameServer.Damage(5, new ConditionEffectIndex[0], 7)));
+            Add("Aoe", Convert.ToHexString(GameServer.Aoe(new Position(3f, 4f), 2.5f, 50, ConditionEffectIndex.Quiet, 0xFF112233u)));
+            Add("EnemyShoot", Convert.ToHexString(GameServer.EnemyShoot(1234, 5, 2, new Position(1f, 2f), 0.5f, 60, 3, 0.1f)));
+            Add("EnemyShootSingle", Convert.ToHexString(GameServer.EnemyShoot(1234, 5, 2, new Position(1f, 2f), 0.5f, 60, 1, 0.1f)));
+            Add("ShowEffect", Convert.ToHexString(GameServer.ShowEffect(ShowEffectIndex.Heal, 5, 0xFFAABBCCu)));
+            Add("ShowEffectPos", Convert.ToHexString(GameServer.ShowEffect(ShowEffectIndex.Heal, 5, 0xFFAABBCCu,
+                new Position(-1.5f, 2f), new Position(3f, 4f))));
+            Add("ThrowEffect", Convert.ToHexString(GameServer.ThrowEffect(5, 0xFF00FF00u, new Position(1f, 2f), 300)));
+            Add("ServerPlayerShoot", Convert.ToHexString(GameServer.ServerPlayerShoot(1, 2, 0x0300, new Position(1f, 1f), 0.5f, 0.1f, new List<Projectile>())));
+
+            var tiles = new List<TileData>
