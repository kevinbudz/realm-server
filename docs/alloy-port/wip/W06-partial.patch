diff --color -ruN -x bin -x obj -x logs -x __pycache__ -x '*.pyc' -x .claude pristine/Networking/SpanReader.cs realm-server/Networking/SpanReader.cs
--- pristine/Networking/SpanReader.cs	1969-12-31 18:00:00.000000000 -0600
+++ realm-server/Networking/SpanReader.cs	2026-10-15 01:12:44.377409603 -0500
@@ -0,0 +1,107 @@
+using System;
+using System.Buffers.Binary;
+using System.IO;
+using System.Text;
+
+namespace RotMG.Networking
+{
+    //[W06] Big-endian reader over a span (the frame body in the receive path). A ref struct, so it never allocates and
+    //never copies the body. Handlers take it as `ref SpanReader rdr` so the cursor advances for the caller too.
+    //
+    //It reproduces the stream-backed PacketReader it replaces, read for read:
+    //  - a fixed-size read past the end throws EndOfStreamException (Read in GameServer.Handlers.cs drops the packet);
+    //  - ReadBytes(n) with n < 0 throws ArgumentOutOfRangeException (Client.Tick then disconnects), and with n past the
+    //    end returns only the bytes that remain (BinaryReader did the same), so a string whose length overruns the
+    //    frame is cut short rather than rejected;
+    //  - ReadString/ReadUTF32 decode UTF-8 from the bytes they read; ReadSingle is a big-endian float.
+    //ReadBytes allocates only the bytes it returns, not the requested count.
+    public ref struct SpanReader
+    {
+        private readonly ReadOnlySpan<byte> _buf;
+        private int _pos;
+
+        public SpanReader(ReadOnlySpan<byte> body)
+        {
+            _buf = body;
+            _pos = 0;
+        }
+
+        public int Position => _pos;
+        public int Remaining => _buf.Length - _pos;
+
+        private ReadOnlySpan<byte> Take(int n)
+        {
+            if (n > _buf.Length - _pos)
+                throw new EndOfStreamException();
+            ReadOnlySpan<byte> s = _buf.Slice(_pos, n);
+            _pos += n;
+            return s;
+        }
+
+        public byte ReadByte()
+        {
+            if (_pos >= _buf.Length)
+                throw new EndOfStreamException();
+            return _buf[_pos++];
+        }
+
+        public bool ReadBoolean()
+        {
+            return ReadByte() != 0;
+        }
+
+        public short ReadInt16()
+        {
+            return BinaryPrimitives.ReadInt16BigEndian(Take(2));
+        }
+
+        public ushort ReadUInt16()
+        {
+            return BinaryPrimitives.ReadUInt16BigEndian(Take(2));
+        }
+
+        public int ReadInt32()
+        {
+            return BinaryPrimitives.ReadInt32BigEndian(Take(4));
+        }
+
+        public float ReadSingle()
+        {
+            return BitConverter.Int32BitsToSingle(BinaryPrimitives.ReadInt32BigEndian(Take(4)));
+        }
+
+        //Same as PacketReader.ReadBytes: a negative count throws, a count past the end yields what is left.
+        public byte[] ReadBytes(int count)
+        {
+            if (count < 0)
+                throw new ArgumentOutOfRangeException(nameof(count));
+            ReadOnlySpan<byte> s = _buf.Slice(_pos, Math.Min(count, _buf.Length - _pos));
+            _pos += s.Length;
+            return s.ToArray();
+        }
+
+        //u16 BE length, then UTF-8 (PacketReader.ReadString).
+        public string ReadString()
+        {
+            return ReadUtf8(ReadInt16());
+        }
+
+        //i32 BE length, then UTF-8 (PacketReader.ReadUTF32).
+        public string ReadUTF32()
+        {
+            return ReadUtf8(ReadInt32());
+        }
+
+        private string ReadUtf8(int count)
+        {
+            if (count < 0)
+                throw new ArgumentOutOfRangeException(nameof(count));
+            ReadOnlySpan<byte> s = _buf.Slice(_pos, Math.Min(count, _buf.Length - _pos));
+            _pos += s.Length;
+            return Encoding.UTF8.GetString(s);
+        }
+
+        //True while bytes remain (PacketReader's PeekChar() != -1 check).
+        public bool HasMore => _pos < _buf.Length;
+    }
+}
